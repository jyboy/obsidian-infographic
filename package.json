{
	"name": "obsidian-infographic",
	"version": "1.1.0",
	"description": "Render infographic diagrams in Obsidian using @antv/infographic",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "oxlint && eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"infographic",
		"diagram"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^24.13.2",
		"esbuild": "0.28.1",
		"eslint": "^10.5.0",
		"eslint-plugin-obsidianmd": "0.3.0",
		"globals": "17.6.0",
		"jiti": "2.7.0",
		"oxlint": "^1.69.0",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.56.1"
	},
	"dependencies": {
		"@antv/infographic": "^0.2.19",
		"obsidian": "latest"
	}
}
